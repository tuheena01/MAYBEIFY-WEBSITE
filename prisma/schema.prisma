// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String              @id @default(uuid())
  email             String              @unique
  name              String
  password          String       
  role              String              @default("AUTHOR") // "AUTHOR", "ADMIN", "AMBASSADOR", "PROJECT_HEAD", "COMPILER"
  referralCode      String              @unique
  referredBy        String?
  isActive          Boolean             @default(false)
  createdAt         DateTime            @default(now())
  
  // Profile Extensions
  phone             String?
  photo             String?             @default("https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&q=80&w=200")
  bio               String?
  authorSince       DateTime            @default(now())
  awards            String?             @default("")
  publications      String?             @default("")
  completionPercent Int                 @default(30)
  status            String              @default("UNDER_REVIEW") // "ACTIVE", "UNDER_REVIEW", "PUBLISHED"
  
  // Payment Details
  bankAccount       String?
  upiId             String?
  paymentMethod     String?             @default("BANK_TRANSFER")
  panGst            String?

  projectHeadId     String?      // Link Compiler to Project Head
  
  manuscripts       Manuscript[]
  royalties         Royalty[]
  messagesSent      Message[]           @relation("MessagesSent")
  messagesRecv      Message[]           @relation("MessagesReceived")
  enrollments       ChallengeEnrollment[]
  books             Book[]
  transactions      Transaction[]
  withdrawalRequests WithdrawalRequest[]
}

model Manuscript {
  id          String   @id @default(uuid())
  title       String
  content     String   
  status      String   @default("PENDING") // "PENDING", "ACCEPTED", "REJECTED"
  progress    Int      @default(0)
  packageName String?
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  compilerId  String?
  projectHeadId String?
  createdAt   DateTime @default(now())
}

model Feedback {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  rating    Int      @default(5)
  createdAt DateTime @default(now())
}

model Royalty {
  id        String   @id @default(uuid())
  amount    Float
  month     String
  status    String   @default("PAID") // "PAID", "PENDING"
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

model Message {
  id         String   @id @default(uuid())
  content    String
  senderId   String
  sender     User     @relation("MessagesSent", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("MessagesReceived", fields: [receiverId], references: [id])
  createdAt  DateTime @default(now())
}


model Merchandise {
  id          String   @id @default(uuid())
  title       String
  description String
  price       Float
  image       String
  createdAt   DateTime @default(now())
}

model ChallengeEnrollment {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  startDate   DateTime @default(now())
  paid        Boolean  @default(false)
  paymentId   String?  // Razorpay Payment ID
  orderId     String?  // Razorpay Order ID
  
  submissions ChallengeSubmission[]
}

model ChallengeSubmission {
  id           String   @id @default(uuid())
  enrollmentId String
  enrollment   ChallengeEnrollment @relation(fields: [enrollmentId], references: [id])
  dayNumber    Int
  content      String
  submittedAt  DateTime @default(now())
}

model Application {
  id        String   @id @default(uuid())
  name      String
  email     String
  title     String
  genre     String
  synopsis  String
  discount  String?  // Saved discount code or percentage
  status    String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  createdAt DateTime @default(now())
}

model Nomination {
  id               String   @id @default(uuid())
  name             String
  email            String
  title            String
  genre            String
  yearOfPublishing String
  instagram        String?  // Instagram ID
  whatsapp         String   // WhatsApp Number
  phone            String   // Calling Number
  reason           String   // Why they should win
  synopsis         String   // About the manuscript
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())
}

model Book {
  id              String                @id @default(uuid())
  title           String
  price           Float
  authorId        String
  author          User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  sales           BookSale[]
  platformReports SalesPlatformReport[]
  createdAt       DateTime              @default(now())

  // Book Details & Analytics Extensions
  cover           String?               @default("https://images.unsplash.com/photo-1543002588-bfa74002ed7e?auto=format&fit=crop&q=80&w=400")
  synopsis        String?
  status          String                @default("UNDER_REVIEW") // "PUBLISHED", "UNDER_REVIEW", "DRAFT", "REJECTED"
  views           Int                   @default(0)
  downloads       Int                   @default(0)
  reads           Int                   @default(0)
  rating          Float                 @default(5.0)
}

model BookSale {
  id          String   @id @default(uuid())
  bookId      String
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  quantity    Int      @default(1)
  amount      Float    
  buyerName   String?
  buyerEmail  String?
  purchasedAt DateTime @default(now())
}

model SalesPlatformReport {
  id             String   @id @default(uuid())
  bookId         String
  book           Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  platform       String   // "AMAZON", "KINDLE", "PLAYBOOKS"
  month          String   // e.g. "July 2026"
  year           Int
  mrp            Float    @default(0.0)
  printingCost   Float    @default(0.0)
  shippingCost   Float    @default(0.0)
  royaltyPerUnit Float    @default(0.0)
  unitsSold      Int      @default(0)
  revenue        Float    @default(0.0)
  screenshot     String?  // URL to Amazon dashboard screenshot
  createdAt      DateTime @default(now())
}

model Transaction {
  id          String   @id @default(uuid())
  description String
  amount      Float
  status      String   @default("PAID") // "PAID", "PENDING"
  type        String   // "ROYALTY", "REFERRAL", "SALE"
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model WithdrawalRequest {
  id        String   @id @default(uuid())
  amount    Float
  status    String   @default("PENDING") // "PENDING", "APPROVED", "REJECTED"
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}


